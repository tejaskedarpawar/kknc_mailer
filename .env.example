# ─── SMTP Configuration ───────────────────────────────────────
# Leave these empty to run in development mode (emails are generated but not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KKNC Solutions <hello@kkncsolutions.dev>
SMTP_REPLY_TO=kkncsolutions@gmail.com

# ─── Server ───────────────────────────────────────────────────
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Logo ─────────────────────────────────────────────────────
# Optional HTTPS logo URL. If empty, logo is embedded via CID.
LOGO_URL=

# ─── Upload Limits ────────────────────────────────────────────
MAX_ATTACHMENT_SIZE=10485760
MAX_TOTAL_ATTACHMENT_SIZE=26214400
