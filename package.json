{
  "name": "kknc-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "KKNC Solutions Internal Email Sender",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "html-to-text": "^9.0.5",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.3",
    "sanitize-html": "^2.14.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/html-to-text": "^9.0.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.13.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
